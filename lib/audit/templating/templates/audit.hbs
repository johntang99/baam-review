    {{/each}}
  </ul>

  <p style="font-family: 'Instrument Serif', 'Noto Serif TC', serif; font-size: 22px; font-style: italic; max-width: 580px; color: var(--ink); margin: 24px 0;">
    {{{t.upgrade_cta_closing}}}
  </p>

  <div class="doc-footer" style="margin-top: auto;">
    <span>BAAM {{#if (eq language "zh")}}評論審計{{else}}Review Audit{{/if}} · {{business_name}}</span>
