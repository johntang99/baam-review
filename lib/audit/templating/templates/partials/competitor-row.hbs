<tr{{#if is_you}} class="you"{{/if}}>
  <td>
    <div class="competitor-name">
      <span class="competitor-rank">{{rank}}</span>
      <span class="competitor-name-text">{{name}}{{#if is_you}} <span class="you-tag">{{../t.you_tag}}</span>{{/if}}{{#if name_secondary}}<br><span class="competitor-name-sec">{{name_secondary}}</span>{{/if}}</span>
    </div>
  </td>
  <td>
    <div class="competitor-address">
      <div class="competitor-address-main">{{address}}</div>
      {{#if distance_display}}
        <div class="competitor-distance">
          <span>{{distance_display}}</span>
          {{#if website_display}}
            <span class="competitor-meta-sep">·</span>
            {{#if website_url}}
              <a
                class="competitor-site-link"
                href="{{website_url}}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{website_display}}
              </a>
            {{else}}
              <span class="competitor-site-text">{{website_display}}</span>
            {{/if}}
          {{/if}}
        </div>
      {{else}}
        {{#if website_display}}
          <div class="competitor-distance">
            {{#if website_url}}
              <a
                class="competitor-site-link"
                href="{{website_url}}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{website_display}}
              </a>
            {{else}}
              <span class="competitor-site-text">{{website_display}}</span>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  </td>
  <td><strong>{{score}}</strong></td>
  <td>{{rating_display}}</td>
  <td>{{total_count}}</td>
  <td>{{last_30d}}</td>
  <td>{{last_90d}}</td>
</tr>
